{
  "name": "playwright_mcp",
  "version": "1.0.0",
  "description": "Beginner-friendly Playwright UI automation with MCP-assisted exploration",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list --project=chromium",
    "test:ci": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:chromium",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "playwright-mcp",
    "test-automation",
    "typescript",
    "ui-automation"
  ],
  "author": "Mahesh Joshi",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2"
  }
}
